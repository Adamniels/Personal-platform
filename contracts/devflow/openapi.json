{
  "components": {
    "schemas": {
      "Attention": {
        "properties": {
          "attention": {
            "type": "boolean"
          }
        },
        "required": [
          "attention"
        ],
        "type": "object"
      },
      "CodeHostMode": {
        "enum": [
          "fake",
          "github"
        ]
      },
      "ConnectRequest": {
        "properties": {
          "installation_id": {
            "format": "int64",
            "type": [
              "null",
              "integer"
            ]
          },
          "repository_id": {
            "format": "int64",
            "type": [
              "null",
              "integer"
            ]
          }
        },
        "required": [
          "installation_id",
          "repository_id"
        ],
        "type": "object"
      },
      "Connectable": {
        "properties": {
          "install_url": {
            "format": "uri",
            "type": "string"
          },
          "installations": {
            "items": {
              "$ref": "#/components/schemas/ConnectableInstallation"
            },
            "type": "array"
          }
        },
        "required": [
          "installations",
          "install_url"
        ],
        "type": "object"
      },
      "ConnectableInstallation": {
        "properties": {
          "account": {
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "repositories": {
            "items": {
              "$ref": "#/components/schemas/ConnectableRepository"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "account",
          "repositories"
        ],
        "type": "object"
      },
      "ConnectableRepository": {
        "properties": {
          "connected": {
            "type": "boolean"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "owner",
          "name",
          "connected"
        ],
        "type": "object"
      },
      "DevFlowStatus": {
        "properties": {
          "code_host": {
            "$ref": "#/components/schemas/CodeHostMode"
          },
          "github": {
            "$ref": "#/components/schemas/GitHubLinkStatus"
          }
        },
        "required": [
          "code_host",
          "github"
        ],
        "type": "object"
      },
      "DisplayData": {
        "properties": {
          "needs_relink": {
            "type": "boolean"
          },
          "projects": {
            "format": "int32",
            "type": "integer"
          },
          "stale": {
            "type": "boolean"
          },
          "stopped": {
            "format": "int32",
            "type": "integer"
          },
          "waiting": {
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "waiting",
          "stopped",
          "projects",
          "stale",
          "needs_relink"
        ],
        "type": "object"
      },
      "GitHubLinkState": {
        "enum": [
          "none",
          "linked",
          "needs_relink"
        ]
      },
      "GitHubLinkStatus": {
        "properties": {
          "login": {
            "type": [
              "null",
              "string"
            ]
          },
          "state": {
            "$ref": "#/components/schemas/GitHubLinkState"
          }
        },
        "required": [
          "state",
          "login"
        ],
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "HttpValidationProblemDetails": {
        "properties": {
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object"
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "format": "int32",
            "type": [
              "null",
              "integer"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "type": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "type": "object"
      },
      "LinkStarted": {
        "properties": {
          "authorize_url": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "authorize_url"
        ],
        "type": "object"
      },
      "MergeRequest": {
        "properties": {
          "head_commit": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "head_commit"
        ],
        "type": "object"
      },
      "OwnerDecision": {
        "properties": {
          "alternative": {
            "type": [
              "null",
              "string"
            ]
          },
          "chosen": {
            "type": "string"
          },
          "why": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "chosen",
          "alternative",
          "why"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "properties": {
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "format": "int32",
            "type": [
              "null",
              "integer"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "type": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "type": "object"
      },
      "Project": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "installation_id": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "repository_id": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "installation_id",
          "repository_id",
          "owner",
          "name",
          "created_at"
        ],
        "type": "object"
      },
      "ProjectFreshness": {
        "properties": {
          "failing": {
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "last_success_at": {
            "format": "date-time",
            "type": [
              "null",
              "string"
            ]
          },
          "name": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "stale": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "owner",
          "name",
          "last_success_at",
          "stale",
          "failing"
        ],
        "type": "object"
      },
      "ProjectList": {
        "properties": {
          "projects": {
            "items": {
              "$ref": "#/components/schemas/Project"
            },
            "type": "array"
          }
        },
        "required": [
          "projects"
        ],
        "type": "object"
      },
      "SendBackRequest": {
        "properties": {
          "comment": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "comment"
        ],
        "type": "object"
      },
      "Stream": {
        "format": "binary",
        "type": "string"
      },
      "WaitingItem": {
        "properties": {
          "can_merge": {
            "type": "boolean"
          },
          "decisions": {
            "items": {
              "$ref": "#/components/schemas/OwnerDecision"
            },
            "type": "array"
          },
          "head_commit": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/WaitingKind"
          },
          "number": {
            "format": "int32",
            "type": "integer"
          },
          "other_decisions": {
            "format": "int32",
            "type": "integer"
          },
          "project_id": {
            "format": "uuid",
            "type": "string"
          },
          "project_name": {
            "type": "string"
          },
          "read_at": {
            "format": "date-time",
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "reviewer_view": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "sent_back": {
            "type": "boolean"
          },
          "slice_number": {
            "format": "int32",
            "type": [
              "null",
              "integer"
            ]
          },
          "summary": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "web_url": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "id",
          "project_id",
          "project_name",
          "number",
          "kind",
          "sent_back",
          "title",
          "web_url",
          "slice_number",
          "head_commit",
          "can_merge",
          "summary",
          "reason",
          "decisions",
          "other_decisions",
          "reviewer_view",
          "read_at"
        ],
        "type": "object"
      },
      "WaitingKind": {
        "enum": [
          "waiting",
          "stopped"
        ]
      },
      "WaitingList": {
        "properties": {
          "count": {
            "format": "int32",
            "type": "integer"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/WaitingItem"
            },
            "type": "array"
          },
          "needs_relink": {
            "type": "boolean"
          },
          "projects": {
            "items": {
              "$ref": "#/components/schemas/ProjectFreshness"
            },
            "type": "array"
          }
        },
        "required": [
          "count",
          "needs_relink",
          "items",
          "projects"
        ],
        "type": "object"
      },
      "WhoAmI": {
        "properties": {
          "account_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "account_id"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "devflow",
    "version": "0.1.0"
  },
  "openapi": "3.1.1",
  "paths": {
    "/devflow/api/attention": {
      "get": {
        "description": "Read from what Dev flow stored and never from GitHub. attention is true when the caller has a pull request, waiting or stopped, that is not sent back, or a GitHub link that has expired, and false otherwise. The nav bar asks it with the session's cookie. Without a valid token, 401 with an empty body.",
        "operationId": "getAttention",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Attention"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "summary": "Whether something needs the caller, for the nav bar",
        "tags": [
          "DevFlow"
        ]
      }
    },
    "/devflow/api/display": {
      "get": {
        "description": "Read from what Dev flow stored and never from GitHub. waiting, the pull requests that wait for the caller and were not sent back; stopped, those the runner stopped on, not sent back; projects, how many the caller has connected; stale, whether any project is stale or failing, as the waiting list says them; and needs_relink, whether the caller's GitHub link has expired. The core calls it with the user's token in the Authorization header. Without a valid token, 401 with an empty body.",
        "operationId": "getDisplay",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DisplayData"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "summary": "What waits, for the front page",
        "tags": [
          "DevFlow"
        ]
      }
    },
    "/devflow/api/github/link": {
      "delete": {
        "description": "Removes the account, its two tokens and any link started. Nothing is revoked at the code host. Without a valid token, 401 with an empty body; from another origin, 403.",
        "operationId": "unlinkGitHub",
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "summary": "Unlink the caller's GitHub account",
        "tags": [
          "DevFlow"
        ]
      },
      "post": {
        "description": "Stores a single use state and a PKCE verifier for ten minutes, and answers the code host's address to send the browser to, carrying the state and the S256 challenge. The code host sends the browser back to /devflow/github/callback. Without a valid token, 401 with an empty body; from another origin, 403.",
        "operationId": "startGitHubLink",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkStarted"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "summary": "Start linking the caller's GitHub account",
        "tags": [
          "DevFlow"
        ]
      }
    },
    "/devflow/api/github/repositories": {
      "get": {
        "description": "Every installation of the app the caller's GitHub account can reach, read as them, with the account it is on and its repositories, sorted by name, each saying whether it is already a project; and install_url, where to install the app. 409 when GitHub is not linked or the link has expired, 503 when GitHub did not answer. Without a valid token, 401 with an empty body; a change from another origin, 403.",
        "operationId": "listConnectableRepositories",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Connectable"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Conflict"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "The repositories the caller can connect",
        "tags": [
          "DevFlow"
        ]
      }
    },
    "/devflow/api/health": {
      "get": {
        "description": "Needs no token. It answers whenever the process serves, and says nothing about what Dev flow depends on.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Whether Dev flow serves",
        "tags": [
          "DevFlow"
        ]
      }
    },
    "/devflow/api/projects": {
      "get": {
        "description": "Each connected repository, by owner and name. Without a valid token, 401 with an empty body; a change from another origin, 403.",
        "operationId": "listProjects",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectList"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "summary": "The caller's projects",
        "tags": [
          "DevFlow"
        ]
      },
      "post": {
        "description": "Asks GitHub, as the caller, whether the repository is among those of the installation they can reach, and only then stores it, with the owner and name GitHub gave. 201 with the project. 404 for a repository the caller cannot reach through that installation, 409 when it is already a project or GitHub is not linked, 422 naming a missing field, 503 when GitHub did not answer. Without a valid token, 401 with an empty body; a change from another origin, 403.",
        "operationId": "connectRepository",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            },
            "description": "Created"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Connect a repository, which makes it a project",
        "tags": [
          "ProjectEndpoints"
        ]
      }
    },
    "/devflow/api/projects/{id}": {
      "delete": {
        "description": "204, and everything Dev flow stored for it goes with it. Nothing changes on GitHub. 404 for a project the caller does not have. Without a valid token, 401 with an empty body; a change from another origin, 403.",
        "operationId": "disconnectProject",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          }
        },
        "summary": "Disconnect a project",
        "tags": [
          "DevFlow"
        ]
      }
    },
    "/devflow/api/projects/{id}/refresh": {
      "post": {
        "description": "204 once it has been read, whether or not GitHub answered, which the list then says; 202 when the read is still under way after 10 seconds, and it goes on. 404 for a project the caller does not have. Without a valid token, 401 with an empty body; a change from another origin, 403.",
        "operationId": "refreshProject",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          }
        },
        "summary": "Read a project from GitHub now",
        "tags": [
          "WaitingEndpoints"
        ]
      }
    },
    "/devflow/api/status": {
      "get": {
        "description": "code_host is fake when GitHub is faked, which every Dev flow page then says in a banner, and github otherwise. github.state is none, linked or needs_relink, with the login it was linked as, null with none. Without a valid token, 401 with an empty body.",
        "operationId": "status",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevFlowStatus"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "summary": "Which code host Dev flow talks to, and the caller's GitHub link",
        "tags": [
          "DevFlow"
        ]
      }
    },
    "/devflow/api/waiting": {
      "get": {
        "description": "Read from what Dev flow stored and never from GitHub. items are the pull requests that are the caller's turn in every project, by project and number; count is those not sent back, plus one when needs_relink; projects says for each when it was last read, stale when that is more than five minutes ago or never, and failing when its last read failed. Without a valid token, 401 with an empty body.",
        "operationId": "listWaiting",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WaitingList"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "summary": "What waits for the caller, as last read",
        "tags": [
          "DevFlow"
        ]
      }
    },
    "/devflow/api/waiting/{id}/merge": {
      "post": {
        "description": "Merges with a merge commit, as the caller's linked GitHub account, only while the pull request's head is head_commit, the commit the page showed. In order: 404 for an item the caller does not have; 422 without head_commit; 409 when it is stopped, sent back, or its checks are not green; 409 when head_commit is not the stored head; 409 when GitHub is not linked or the link has expired; then GitHub is asked. 204 once merged and the project read again. 409 when GitHub says the head moved, after the project is read again, and when GitHub will not merge it or refuses, with its reason; 503 when GitHub did not answer. Without a valid token, 401 with an empty body; a change from another origin, 403.",
        "operationId": "mergeWaiting",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MergeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
