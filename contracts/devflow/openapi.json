{
  "components": {
    "schemas": {
      "CodeHostMode": {
        "enum": [
          "fake",
          "github"
        ]
      },
      "DevFlowStatus": {
        "properties": {
          "code_host": {
            "$ref": "#/components/schemas/CodeHostMode"
          }
        },
        "required": [
          "code_host"
        ],
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "WhoAmI": {
        "properties": {
          "account_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "account_id"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "devflow",
    "version": "0.1.0"
  },
  "openapi": "3.1.1",
  "paths": {
    "/devflow/api/health": {
      "get": {
        "description": "Needs no token. It answers whenever the process serves, and says nothing about what Dev flow depends on.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Whether Dev flow serves",
        "tags": [
          "DevFlow"
        ]
      }
    },
    "/devflow/api/status": {
      "get": {
        "description": "fake when GitHub is faked, which every Dev flow page then says in a banner, and github otherwise. Without a valid token, 401 with an empty body.",
        "operationId": "status",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevFlowStatus"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "summary": "Which code host Dev flow talks to",
        "tags": [
          "DevFlow"
        ]
      }
    },
    "/devflow/api/whoami": {
      "get": {
        "description": "From the token alone. Without a valid token, 401 with an empty body.",
        "operationId": "whoami",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoAmI"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "summary": "The account the request's token names",
        "tags": [
          "DevFlow"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "DevFlow"
    }
  ]
}
