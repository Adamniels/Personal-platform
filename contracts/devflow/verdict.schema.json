{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dev flow's reviewer verdict",
  "type": "object",
  "properties": {
    "verdict": {
      "enum": [
        "approve",
        "changes"
      ]
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "blocking": {
            "type": "boolean"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "what": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        },
        "required": [
          "blocking",
          "file",
          "line",
          "what",
          "why"
        ],
        "additionalProperties": false
      }
    },
    "for_owner": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string"
          },
          "view": {
            "type": "string"
          }
        },
        "required": [
          "decision",
          "view"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "verdict",
    "summary",
    "findings",
    "for_owner"
  ],
  "additionalProperties": false
}
