  "info": {
    "title": "brain",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/brain/api/entities": {
      "get": {
        "description": "Every named thing the user has, by name.",
        "operationId": "list_entities_brain_api_entities_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Entity"
                  },
                  "title": "Response List Entities Brain Api Entities Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "No valid token: missing, expired or failing verification, all alike. The body is empty; the caller refreshes and retries."
          }
        },
        "summary": "List Entities"
      },
      "post": {
        "description": "A new named thing, with an optional label such as project. A name the\nuser already has, in any letter case, is 409.",
        "operationId": "create_entity_brain_api_entities_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "label": {
                    "anyOf": [
                      {
                        "maxLength": 80,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Label"
                  },
                  "name": {
                    "maxLength": 200,
                    "minLength": 1,
                    "title": "Name",
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ],
                "title": "NewEntity",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entity"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "No valid token: missing, expired or failing verification, all alike. The body is empty; the caller refreshes and retries."
          },
          "409": {
            "description": "It would be the user's second of something unique."
          },
          "422": {
            "description": "A body that does not parse, or a request breaking a rule."
          }
        },
        "summary": "Create Entity"
      }
    },
    "/brain/api/events": {
      "post": {
        "description": "Records what happened, 201. The same origin and idempotency key again\nis 200, with the event already recorded. 422 for an unknown verb, an\norigin of brain, evidence that is missing or blank, a topic and a named\nthing together, a malformed slug, or a payload that is not a JSON object\nof at most 16 KiB. An unknown topic is created provisional, an unknown\nnamed thing is created too.",
        "operationId": "record_event_brain_api_events_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "description": "What happened, as a feature sends it. A field it does not know is\nrefused, so a misspelt one is not silently lost.",
                "properties": {
                  "entity": {
                    "anyOf": [
                      {
                        "maxLength": 200,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Entity"
                  },
                  "evidence": {
                    "maxLength": 4000,
                    "minLength": 1,
                    "title": "Evidence",
                    "type": "string"
                  },
                  "idempotency_key": {
                    "maxLength": 200,
                    "minLength": 1,
                    "title": "Idempotency Key",
                    "type": "string"
                  },
                  "item": {
                    "anyOf": [
                      {
                        "format": "uuid",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Item"
                  },
                  "occurred_at": {
                    "anyOf": [
                      {
                        "format": "date-time",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Occurred At"
                  },
                  "occurred_precision": {
                    "default": "instant",
                    "enum": [
                      "instant",
                      "day",
                      "month",
                      "year"
                    ],
                    "title": "Occurred Precision",
                    "type": "string"
                  },
                  "origin": {
                    "maxLength": 80,
                    "pattern": "^[a-z0-9][a-z0-9-]{0,79}$",
                    "title": "Origin",
                    "type": "string"
                  },
                  "payload": {
                    "additionalProperties": true,
                    "title": "Payload",
                    "type": "object"
                  },
                  "payload_version": {
                    "maximum": 2147483647.0,
                    "minimum": 1.0,
                    "title": "Payload Version",
                    "type": "integer"
                  },
                  "run": {
                    "anyOf": [
                      {
                        "maxLength": 200,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Run"
                  },
                  "source": {
                    "anyOf": [
                      {
                        "maxLength": 200,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Source"
                  },
                  "topic": {
                    "anyOf": [
                      {
                        "maxLength": 80,
                        "pattern": "^[a-z0-9][a-z0-9-]{0,79}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Topic"
                  },
                  "verb": {
                    "maxLength": 80,
                    "minLength": 1,
                    "title": "Verb",
                    "type": "string"
                  }
                },
                "required": [
                  "verb",
                  "origin",
                  "evidence",
                  "payload",
                  "payload_version",
                  "idempotency_key"
                ],
                "title": "NewEvent",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            },
            "description": "The user already has an event from this origin with this key: that event, unchanged."
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "No valid token: missing, expired or failing verification, all alike. The body is empty; the caller refreshes and retries."
          },
          "422": {
            "description": "A body that does not parse, or a request breaking a rule."
          }
        },
        "summary": "Record Event"
      }
    },
    "/brain/api/health": {
      "get": {
        "description": "Public: answers whenever the process serves, and needs no token.",
        "operationId": "health_brain_api_health_get",
