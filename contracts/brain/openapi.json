        "summary": "List Topics"
      },
      "post": {
        "description": "A new canonical topic. A slug that is not given is made from the name;\none the user already has is 409.",
        "operationId": "create_topic_brain_api_topics_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "name": {
                    "maxLength": 200,
                    "minLength": 1,
                    "title": "Name",
                    "type": "string"
                  },
                  "slug": {
                    "anyOf": [
                      {
                        "maxLength": 80,
                        "pattern": "^[a-z0-9][a-z0-9-]{0,79}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Slug"
                  }
                },
                "required": [
                  "name"
                ],
                "title": "NewTopic",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Topic"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "No valid token: missing, expired or failing verification, all alike. The body is empty; the caller refreshes and retries."
          },
          "409": {
            "description": "It would be the user's second of something unique."
          },
          "422": {
            "description": "A body that does not parse, or a request breaking a rule."
          }
        },
        "summary": "Create Topic"
      }
    },
    "/brain/api/topics/{id}/broader": {
      "post": {
        "description": "Places the topic under a broader one, a broader_than relation from the\nbroader topic to this one. 422 when the broader topic is not there or the\nrelation would close a loop, read through aliases; 409 when it already\nholds.",
        "operationId": "add_broader_brain_api_topics__id__broader_post",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "broader_id": {
                    "format": "uuid",
                    "title": "Broader Id",
                    "type": "string"
                  }
                },
                "required": [
                  "broader_id"
                ],
                "title": "Broader",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TopicRelation"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "No valid token: missing, expired or failing verification, all alike. The body is empty; the caller refreshes and retries."
          },
          "404": {
            "description": "Nothing of this user's at that address."
          },
          "409": {
            "description": "It would be the user's second of something unique."
          },
          "422": {
            "description": "A body that does not parse, or a request breaking a rule."
          }
        },
        "summary": "Add Broader"
      }
    },
