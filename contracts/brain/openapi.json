      }
    },
    "/brain/api/topic-relations/{id}/end": {
      "post": {
        "description": "Ends a relation, which stays, with the time it ended. One already\nended is answered as it is.",
        "operationId": "end_relation_brain_api_topic_relations__id__end_post",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
