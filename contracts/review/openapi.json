    "/review/api/queue": {
      "get": {
        "description": "The cards due at or before now, oldest due first, at most 200, each as a single read answers it plus when each grade would bring it back; total, how many are due in all; as_of, the now every preview is counted from; and next_due, the earliest due after it, or null. Narrowed to a deck by ?deck=<id>, to a topic by ?topic=<slug>, or both, total and next_due with them. 422 for a topic that is no slug.",
        "operationId": "getQueue",
        "parameters": [
          {
            "in": "query",
            "name": "deck",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "topic",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DueCards"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "The cards due now",
        "tags": [
          "Review"
        ]
      }
    },
    "/review/api/whoami": {
      "get": {
        "description": "From the token alone. Without a valid token, 401 with an empty body.",
        "operationId": "whoami",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoAmI"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "summary": "The account the request's token names",
        "tags": [
          "Review"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "Review"
    }
  ]
