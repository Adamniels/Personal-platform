# The brain reads these from the process environment and loads no .env file:
# export them yourself. Unset means the default shown, and a value that is set
# must parse or the brain refuses to start. See Brain/README.md.

# The core's own address, never the proxy. A scheme, a host and an optional
# port, nothing after.
BRAIN_CORE_URL=http://127.0.0.1:8080

# The platform's origin exactly as a browser sends it in the Origin header.
BRAIN_PUBLIC_ORIGIN=https://platform.test
