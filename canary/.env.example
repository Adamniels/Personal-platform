# Canary reads these from the process environment and loads no .env file:
# export them yourself. Unset means the default shown, and a value that is set
# must parse or canary refuses to start. See canary/README.md.

# The core's own address, never the proxy, for its key set at
# /.well-known/jwks.json. A scheme, a host and an optional port, nothing after.
CANARY_CORE_URL=http://127.0.0.1:8080

# The platform's origin exactly as a browser sends it in the Origin header.
CANARY_PUBLIC_ORIGIN=https://platform.test

# What GET /canary/api/display does, for every request: normal serves the
# data, error answers 500, hang sleeps far past the core's deadline. Any other
# value stops canary at startup. Changed by restarting canary.
CANARY_DISPLAY_MODE=normal
