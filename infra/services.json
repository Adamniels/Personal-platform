{
  "services": [
    {
      "name": "core",
      "dir": "Core",
      "port": 8080,
      "health": "/login",
      "language": "rust",
      "area": "core",
      "migrate": "SQLX_OFFLINE=true cargo run --locked -- migrate",
      "start": "cargo run --locked -q",
      "public_origin": "CORE_PUBLIC_ORIGIN",
      "database": {
        "name": "core",
        "owner": "core_owner",
        "app": "core_app",
        "owner_password": "CORE_OWNER_PASSWORD",
        "app_password": "CORE_APP_PASSWORD",
        "owner_url": "CORE_OWNER_DATABASE_URL"
      }
    },
    {
      "name": "canary",
      "dir": "canary",
      "port": 8081,
      "language": "python",
      "area": "canary",
      "e2e": ["tests/test_canary.py"],
      "start": "UV_LOCKED=1 uv run uvicorn canary.app:app --host \"$HOST\" --port \"$PORT\"",
      "public_origin": "CANARY_PUBLIC_ORIGIN"
    },
    {
      "name": "brain",
      "dir": "Brain",
      "port": 8082,
      "health": "/brain/api/health",
      "language": "python",
      "area": "brain",
      "e2e": ["tests/test_brain.py", "tests/test_memory*.py"],
      "migrate": "UV_LOCKED=1 uv run brain migrate",
      "start": "UV_LOCKED=1 uv run uvicorn brain.app:app --host \"$HOST\" --port \"$PORT\"",
      "public_origin": "BRAIN_PUBLIC_ORIGIN",
      "database": {
        "name": "brain",
        "owner": "brain_owner",
        "app": "brain_app",
        "owner_password": "BRAIN_OWNER_PASSWORD",
        "app_password": "BRAIN_APP_PASSWORD",
        "owner_url": "BRAIN_OWNER_DATABASE_URL",
        "app_url": "BRAIN_APP_DATABASE_URL"
      }
    },
    {
      "name": "review",
      "dir": "review",
      "port": 8083,
      "health": "/review/api/health",
      "language": "dotnet",
      "area": "dotnet",
      "e2e": ["tests/test_review*.py"],
      "migrate": "dotnet run --project src/Review -c Release --no-launch-profile -- migrate",
      "start": "REVIEW_LISTEN_ADDR=\"$HOST:$PORT\" dotnet run --project src/Review -c Release --no-launch-profile",
      "public_origin": "REVIEW_PUBLIC_ORIGIN",
      "database": {
        "name": "review",
        "owner": "review_owner",
        "app": "review_app",
        "owner_password": "REVIEW_OWNER_PASSWORD",
        "app_password": "REVIEW_APP_PASSWORD",
        "owner_url": "REVIEW_OWNER_DATABASE_URL",
        "app_url": "REVIEW_APP_DATABASE_URL"
      },
      "ci": {
        "init_script": "infra/postgres/initdb/review.sh"
      }
    },
    {
      "name": "devflow",
      "dir": "devflow",
      "port": 8084,
      "health": "/devflow/api/health",
      "language": "dotnet",
      "area": "dotnet",
      "e2e": ["tests/test_devflow*.py"],
      "migrate": "dotnet run --project src/DevFlow -c Release --no-launch-profile -- migrate",
      "start": "DEVFLOW_LISTEN_ADDR=\"$HOST:$PORT\" dotnet run --project src/DevFlow -c Release --no-launch-profile",
      "public_origin": "DEVFLOW_PUBLIC_ORIGIN",
      "database": {
        "name": "devflow",
        "owner": "devflow_owner",
        "app": "devflow_app",
        "owner_password": "DEVFLOW_OWNER_PASSWORD",
        "app_password": "DEVFLOW_APP_PASSWORD",
        "owner_url": "DEVFLOW_OWNER_DATABASE_URL",
        "app_url": "DEVFLOW_APP_DATABASE_URL"
      },
      "ci": {
        "init_script": "infra/postgres/initdb/devflow.sh"
      }
    }
  ]
}
