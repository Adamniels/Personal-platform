{
	# Caddy runs in a container, so installing its root there would trust
	# nothing on the laptop. The root is trusted by hand, see README.md.
	skip_install_trust
}

platform.test {
	# .test is not a name Caddy treats as local, so without this it would
	# ask Let's Encrypt and fail. Caddy's own CA signs instead.
	tls internal

	# Each feature's route here has its entry in features.toml beside this
	# file, and its port in services.json, and the three change in the same
	# commit. The brain is a service, not a feature, and has no entry in
	# features.toml.
	#
	# /canary and everything under it, but not /canaryfoo. handle rather
	# than handle_path, so canary receives the prefix.
	@canary path /canary /canary/*
	handle @canary {
		reverse_proxy host.docker.internal:8081
	}

	# Review, the same way.
	@review path /review /review/*
	handle @review {
		reverse_proxy host.docker.internal:8083
	}

	# The brain, the same way.
	@brain path /brain /brain/*
	handle @brain {
		reverse_proxy host.docker.internal:8082
	}

	# The design folder, mounted at /srv/design, serves exactly these paths
	# and nothing else under /design/: not DESIGN.md, not reference/. A slice
	# that needs another path adds it here. no-cache so a browser revalidates
	# and a change to the look is seen on the next load. See README.md.
	@design path /design/tokens.css /design/fonts.css /design/fonts/* /design/sprites/* /design/page.css /design/theme.js /design/nav.js
	handle @design {
		root * /srv
		header Cache-Control no-cache
		file_server
	}

	# The component gallery, built by `npm run build:gallery` in design/ui
	# into design/ui/gallery/dist, which is git ignored. Without a build this
	# answers 404. See design/ui/README.md.
	@gallery path /design/gallery /design/gallery/*
	handle @gallery {
		redir /design/gallery /design/gallery/ 308
		uri strip_prefix /design/gallery
		root * /srv/design/ui/gallery/dist
		header Cache-Control no-cache
		file_server
	}

	@design_other path /design /design/*
	handle @design_other {
		respond 404
	}

	handle {
		reverse_proxy host.docker.internal:8080
	}
}
