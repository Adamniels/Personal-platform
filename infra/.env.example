# Passwords for the Postgres container. All seven are read only when the
# volume is first created, by the image's entrypoint and by the scripts in
# postgres/initdb/; changing them afterwards has no effect on the database.
# A volume created before a pair existed gets it by running that service's
# script by hand, see "The databases" in infra/README.md.

# Superuser, for maintenance by hand. No service connects as it.
POSTGRES_PASSWORD=

# The core's database: the owner runs migrations, the app role is what the
# running core connects as.
CORE_OWNER_PASSWORD=
CORE_APP_PASSWORD=

# The brain's database, the same two roles: the owner runs `brain migrate`,
# the app role is what the running brain connects as.
BRAIN_OWNER_PASSWORD=
BRAIN_APP_PASSWORD=

# Review's database, the same two roles: the owner runs review's `migrate`,
# the app role is what review connects as while it serves.
REVIEW_OWNER_PASSWORD=
REVIEW_APP_PASSWORD=
