<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!--
      dotnet run starts review from review/, where infra/services.json starts it and web/dist is,
      rather than from this project's folder, which the Web SDK would choose.
    -->
    <RunWorkingDirectory>$(MSBuildProjectDirectory)/../..</RunWorkingDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- Generates the OpenAPI document contracts/review/openapi.json holds, see review/README.md. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!--
      The runtime of the brain's client, which Kiota generates into Brain/Generated/ from
      contracts/brain/openapi.json. See "What Review tells the brain" in review/README.md.
    -->
    <PackageReference Include="Microsoft.Kiota.Bundle" />
  </ItemGroup>
  <ItemGroup>
    <!--
      review/migrations/*.sql, embedded so `migrate` reads them from the assembly wherever it runs,
      each under migrations/<file name>. See "Migrating" in review/README.md.
    -->
    <EmbeddedResource Include="../../migrations/*.sql" LogicalName="migrations/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../libs/dotnet/PlatformAuth/src/PlatformAuth/PlatformAuth.csproj" />
    <!--
      The door and the migrator, and through it the database packages, Npgsql and Dapper, at the
      library's versions. See "The database" in review/README.md.
    -->
    <ProjectReference Include="../../../libs/dotnet/PlatformData/src/PlatformData/PlatformData.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Review.Tests" />
  </ItemGroup>
</Project>
