<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!--
      dotnet run starts Dev flow from devflow/, where infra/services.json starts it and web/dist
      is, rather than from this project's folder, which the Web SDK would choose.
    -->
    <RunWorkingDirectory>$(MSBuildProjectDirectory)/../..</RunWorkingDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- Generates the OpenAPI document contracts/devflow/openapi.json holds, see devflow/README.md. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>
  <ItemGroup>
    <!--
      devflow/migrations/*.sql, embedded so `migrate` reads them from the assembly wherever it runs,
      each under migrations/<file name>. See "Migrating" in devflow/README.md.
    -->
    <EmbeddedResource Include="../../migrations/*.sql" LogicalName="migrations/%(Filename)%(Extension)" />
    <!-- The briefs' templates, read by Briefs/Brief.cs, see devflow/README.md. -->
    <EmbeddedResource Include="Briefs/developer.md" LogicalName="briefs/developer.md" />
    <EmbeddedResource Include="Briefs/reviewer.md" LogicalName="briefs/reviewer.md" />
    <EmbeddedResource Include="Briefs/looking.md" LogicalName="briefs/looking.md" />
    <EmbeddedResource Include="Briefs/conflict.md" LogicalName="briefs/conflict.md" />
    <EmbeddedResource Include="Briefs/feature-reviewer.md" LogicalName="briefs/feature-reviewer.md" />
    <EmbeddedResource Include="Briefs/feature-fixer.md" LogicalName="briefs/feature-fixer.md" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../libs/dotnet/PlatformAuth/src/PlatformAuth/PlatformAuth.csproj" />
    <!--
      The door and the migrator, and through it the database packages, Npgsql and Dapper, at the
      library's versions. See "The database" in devflow/README.md.
    -->
    <ProjectReference Include="../../../libs/dotnet/PlatformData/src/PlatformData/PlatformData.csproj" />
    <!-- What a worker and Dev flow say to each other, which the worker routes take. -->
    <ProjectReference Include="../DevFlow.Protocol/DevFlow.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DevFlow.Tests" />
  </ItemGroup>
</Project>
