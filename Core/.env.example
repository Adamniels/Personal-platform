# Address the core listens on, an IP and a port, such as 127.0.0.1:8080
CORE_LISTEN_ADDR=

# The core's database as the app role, which owns nothing. Never the owner's.
# postgres://core_app:PASSWORD@127.0.0.1:5432/core
CORE_APP_DATABASE_URL=

# Not set here: the owner's connection string, CORE_OWNER_DATABASE_URL. This
# file is loaded on every run, the server's included, so the owner's string
# goes in the terminal for the migrate command only:
#   CORE_OWNER_DATABASE_URL='postgres://core_owner:PASSWORD@127.0.0.1:5432/core' cargo run -- migrate
# See "Row level security does not apply here" in docs/core-architecture.md.


