# Address the core listens on, an IP and a port, such as 127.0.0.1:8080
CORE_LISTEN_ADDR=

# The platform's own origin, exactly as a browser sends it in the Origin
# header: scheme and host, lowercase, no path, such as https://platform.test.
# Every request that can change state must carry it.
CORE_PUBLIC_ORIGIN=

# The key every token is signed with, the 32 byte Ed25519 seed in base64url.
# Every environment makes its own, never copied from another, by running
#   cargo run -q -- keygen >> .env
# which appends this line. The core refuses to start without it. See "The
# signing key" in docs/core-architecture.md.
# CORE_SIGNING_KEY=

# How long an access token lasts, and so the revocation window: a whole number
# and s, m, h or d. Unset is 30m. Set it short, such as 1m, only to walk expiry
# by hand.
# CORE_ACCESS_TOKEN_LIFETIME=

# The core's database as the app role, which owns nothing. Never the owner's.
# postgres://core_app:PASSWORD@127.0.0.1:5432/core
CORE_APP_DATABASE_URL=

# Not set here: the owner's connection string, CORE_OWNER_DATABASE_URL. This
# file is loaded on every run, the server's included, so the owner's string
# goes in the terminal for the migrate command only. It builds from the offline
# query cache, since on a fresh database the tables the query macros check do
# not exist until it has run:
#   SQLX_OFFLINE=true CORE_OWNER_DATABASE_URL='postgres://core_owner:PASSWORD@127.0.0.1:5432/core' cargo run -- migrate
# See "Row level security does not apply here" in docs/core-architecture.md.
#
# Not set here either: CORE_TEST_ADMIN_DATABASE_URL, the Postgres superuser,
# which the tests use to create a database per test, set for cargo test only.
# See tests/common/mod.rs.


